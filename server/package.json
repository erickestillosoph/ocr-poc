{
  "name": "server",
  "version": "1.0.0",
  "description": "Express.js minimal API server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "start:loader": "node --experimental-specifier-resolution=node ./loader.mjs",
    "start:dev": "node --experimental-specifier-resolution=node ./devLoader.mjs"
  },
  "engines": {
    "node": ">=18.x"
  },
  "keywords": [
    "express",
    "serverless",
    "ocr",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.8",
    "@aws-sdk/client-rekognition": "^3.577.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^3.2.0",
    "sharp": "^0.33.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.17.30",
    "@types/sharp": "^0.32.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
