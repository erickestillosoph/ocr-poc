{
  "version": 2,
  "builds": [
    {
      "src": "src/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "build": {
          "commands": [
            "mkdir -p src/tmp/uploads",
            "rm -rf src/tmp/uploads/*",
            "npm run build"
          ]
        },
        "cache": false
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/index.ts"
    }
  ]
}
